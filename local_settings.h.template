#ifndef LOCAL_SETTINGS_H
#define LOCAL_SETTINGS_H

// WiFi and server configuration — edit these before flashing

// WiFi SSID is case-sensitive
#ifndef WIFI_SSID
#define WIFI_SSID        "your-ssid-here"
#endif

#ifndef WIFI_PASSWORD
#define WIFI_PASSWORD    "your-password-here"
#endif

// Web server address (hostname, or the IP address of your computer ('en0' on Mac))
#ifndef WEB_SERVER_ADDRESS
#define WEB_SERVER_ADDRESS "your-web-server-address-here"
#endif

// Web server port - note, must be a string
#ifndef WEB_SERVER_PORT
#define WEB_SERVER_PORT "3400"
#endif

#endif
